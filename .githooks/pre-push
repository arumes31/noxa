#!/usr/bin/env sh
set -e

echo "[pre-push] Running fast local verification..."

# 1. Check gofmt formatting
if command -v gofmt >/dev/null 2>&1; then
    FMT=$(gofmt -l .)
    if [ -n "$FMT" ]; then
        echo "[pre-push] Error: gofmt formatting issues detected in:"
        echo "$FMT"
        echo "Run 'gofmt -w .' to fix before pushing."
        exit 1
    fi
fi

# 2. Check frontend lint
if [ -d "client/frontend" ] && command -v node >/dev/null 2>&1; then
    echo "[pre-push] Running client/frontend lint..."
    (cd client/frontend && node scripts/lint.mjs)
fi

# 3. Check version metadata
if command -v go >/dev/null 2>&1; then
    echo "[pre-push] Verifying version consistency..."
    go run ./cmd/version -check
fi

echo "[pre-push] All local checks passed successfully!"
exit 0
