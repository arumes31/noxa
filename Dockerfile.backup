# syntax=docker/dockerfile:1.24.0@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
# Keep rclone in a separate pinned source image so the backup runtime does not
# install packages at startup.
FROM rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5 AS rclone

FROM postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea

# rclone's official image installs its binary at this path.
COPY --from=rclone /usr/local/bin/rclone /usr/local/bin/rclone
# The PostgreSQL Alpine image removes the temporary CA dependency used to build
# gosu; retain rclone's CA bundle without installing packages at runtime.
COPY --from=rclone /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY scripts/secret-env.sh /usr/local/lib/noxa/secret-env.sh
COPY scripts/postgres-backup.sh /usr/local/bin/postgres-backup.sh
COPY scripts/postgres-backup-entrypoint.sh /usr/local/bin/postgres-backup-entrypoint.sh
COPY scripts/postgres-backup-scheduler.sh /usr/local/bin/postgres-backup-scheduler.sh
RUN chmod 0555 /usr/local/lib/noxa/secret-env.sh \
    /usr/local/bin/postgres-backup.sh \
    /usr/local/bin/postgres-backup-entrypoint.sh \
    /usr/local/bin/postgres-backup-scheduler.sh

STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/local/bin/postgres-backup-entrypoint.sh"]
CMD ["/usr/local/bin/postgres-backup-scheduler.sh"]
