# noxa environment variables sample.
# Copy to .env and adjust. All variables are prefixed with NOXA_ and override
# values in config.yaml. Nested keys use _ as a separator (e.g. NOXA_TCP_ADDR).

# SECURITY: this file selects a development stack. Before production set
# NOXA_DEV_MODE=false, set a strong non-empty NOXA_SERVER_PASSWORD, replace
# default database credentials with TLS-enabled production credentials, and
# keep both NOXA_TLS_ENABLED and NOXA_FILE_TLS_ENABLED true.
NOXA_SERVER_NAME=noXa
NOXA_SERVER_PASSWORD=  # DEVELOPMENT ONLY: production action: set a strong non-empty password
NOXA_LOG_LEVEL=info          # debug | info | warn | error
NOXA_DEV_MODE=true           # DEVELOPMENT ONLY: production action: false

NOXA_TCP_ADDR=:12333
NOXA_UDP_ADDR=:12334
NOXA_UDP_RATE_LIMIT_PPS=200
NOXA_UDP_RATE_BURST=400
NOXA_GRPC_ADDR=127.0.0.1:12338
NOXA_HEALTH_ADDR=:12337       # /dl bearer links are plaintext HTTP; bind loopback or proxy HTTPS
NOXA_METRICS_ALLOW_REMOTE=false
NOXA_PPROF_ENABLED=false      # disabled unless local runtime profiling is needed
NOXA_SHUTDOWN_TIMEOUT=30s     # shared grace period for orderly shutdown; must be positive
NOXA_QUERY_ADDR=127.0.0.1:12335
# Raw ServerQuery is plaintext. Set this true only together with an intentional
# non-loopback NOXA_QUERY_ADDR; prefer SSH for remote administration.
NOXA_QUERY_ALLOW_REMOTE=false
# ServerQuery over SSH (224): same commands and credentials as the raw port.
NOXA_QUERY_SSH_ENABLED=false
NOXA_QUERY_SSH_ADDR=:12339
NOXA_QUERY_SSH_HOST_KEY=./data/keys/query_ssh_host.key

# File transfer.
NOXA_FILE_ADDR=:12336
NOXA_FILE_ROOT=./data/files
NOXA_FILE_MAX_KBPS=0
NOXA_FILE_MAX_CONNECTIONS=128
NOXA_FILE_CHANNEL_QUOTA_MB=0
NOXA_FILE_MAX_SIZE_MB=100
NOXA_FILE_QUIET_HOURS_START=0
NOXA_FILE_QUIET_HOURS_END=0

# DEVELOPMENT ONLY: production action: unique credentials with sslmode=require,
# verify-ca, or verify-full; never use noxa:noxa in production.
NOXA_DATABASE_URL=postgres://noxa:noxa@localhost:5432/noxa?sslmode=disable
NOXA_PII_KEY_FILE=./data/keys/pii.key
NOXA_REDIS_ADDR=localhost:6379
NOXA_REDIS_PASSWORD=
NOXA_REDIS_ENABLED=true
NOXA_REDIS_DIAL_TIMEOUT=5s
NOXA_REDIS_READ_TIMEOUT=3s
NOXA_REDIS_WRITE_TIMEOUT=3s
NOXA_REDIS_TLS_ENABLED=false
NOXA_REDIS_TLS_SERVER_NAME=
NOXA_REDIS_TLS_CA_FILE=

NOXA_MAX_CLIENTS=1024
NOXA_CLIENT_TIMEOUT_SECONDS=90
NOXA_DEFAULT_OPUS_BITRATE=32000
NOXA_DEFAULT_OPUS_FEC=true
NOXA_DEFAULT_OPUS_DTX=false
NOXA_DEFAULT_OPUS_STEREO=false

# Echo test channel (empty = disabled). Publishers in it hear their own audio.
NOXA_ECHO_CHANNEL_NAME="Echo Test"
NOXA_CHANNEL_TEMP_LIFETIME_SECONDS=60

# TLS 1.3 for control and file transfer (default on). Cert/key empty =
# auto-generate a self-signed cert into NOXA_TLS_DIR on first start.
NOXA_TLS_ENABLED=true  # DEVELOPMENT ONLY false: production action: leave true
NOXA_TLS_DIR=./data/tls
NOXA_TLS_CERT_FILE=
NOXA_TLS_KEY_FILE=
NOXA_FILE_TLS_ENABLED=true  # DEVELOPMENT ONLY false: production action: leave true

# Chat payload encryption (wave 4b). Plaintext chat is rejected by default;
# true = dev escape hatch for old clients.
NOXA_CHAT_ALLOW_PLAINTEXT=false  # DEVELOPMENT ONLY true: production action: leave false
NOXA_CHAT_MASTER_KEY_FILE=./data/keys/chat_master.key
# Optional secret-injection override. NOXA_CHAT_MASTER_KEY takes precedence
# over NOXA_CHAT_MASTER_KEY_FILE and accepts either one base64 32-byte key or
# a newline-separated key ring of id:base64 entries. Inject it from a secret
# manager; do not commit it to this file.
NOXA_CHAT_MASTER_KEY=
NOXA_CHAT_LEGACY_HISTORY=encrypt
NOXA_CHAT_KEY_ROTATE_MIN_SECONDS=60
NOXA_CHAT_SEARCH_MAX_MESSAGES=2000
NOXA_SERVER_INFO_MOTD=false
NOXA_DEFAULT_GROUPS_ENABLED=true

# Chat moderation & limits (wave 5a).
NOXA_CHAT_MAX_LENGTH=4096
NOXA_CHAT_RATE_MSGS=5
NOXA_CHAT_RATE_WINDOW_SECONDS=3
NOXA_CHAT_WORD_FILTER=
NOXA_CHAT_LINK_BLACKLIST=
NOXA_CHAT_LINK_WHITELIST=

# TURN server for NAT traversal (445/446). Only needed behind restrictive
# NATs. NOXA_TURN_SECRET must match the coturn static-auth-secret (see the
# "turn" profile in docker-compose.yml); empty disables TURN.
# When running the dockerized coturn, set TURN_SECRET/TURN_REALM below to the
# SAME values: they configure coturn itself, and the two sides disagree
# silently if only one pair is filled in (445).
NOXA_TURN_SECRET=
NOXA_TURN_REALM=noxa
# Comma-separated TURN URIs handed to clients.
NOXA_TURN_URIS=
NOXA_TURN_CREDENTIALS_TTL=24h

# Database connection pool tuning.
NOXA_DB_MAX_OPEN_CONNS=25
NOXA_DB_MAX_IDLE_CONNS=5
NOXA_DB_CONN_MAX_LIFETIME=30m

# WebRTC (Pion) engine configuration.
# NOXA_WEBRTC_ICE_SERVERS is a comma-separated list of STUN/TURN URLs.
# If empty, the engine falls back to "stun:stun.l.google.com:19302".
NOXA_WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
# Register the AV1 video codec (optional; not all clients support it).
NOXA_WEBRTC_ENABLE_AV1=false
# Container NAT: share a single forwarded UDP port instead of dynamic sockets.
# Publish the same host/container port, e.g. 12341:12341/udp. Empty = automatic.
NOXA_WEBRTC_UDP_ADDR=
# Comma-separated external IPv4 addresses; requires UDP_ADDR above.
NOXA_WEBRTC_EXTERNAL_IPS=

# Server-side recording (ffmpeg subprocess). Nested list options
# (recording.video_args / audio_args) are YAML-only; use config.yaml to set
# hardware encoders such as -c:v h264_nvenc / h264_qsv / h264_vaapi.
NOXA_RECORDING_ENABLED=false
NOXA_RECORDING_DIR=recordings
NOXA_RECORDING_FFMPEG_PATH=ffmpeg
NOXA_RECORDING_FORMAT=webm

# ---------------------------------------------------------------------------
# Docker Compose credentials
# These are consumed by docker-compose.yml (not the NOXA_* app vars above).
# Copy .env.example to .env before running `make compose-up`. The values below
# deliberately select a host-local DEVELOPMENT stack. Replace the password and
# set NOXA_DEV_MODE=false before production use. Each secret accepts a plain
# value or its _FILE counterpart; set only one non-empty source. Files are read
# inside the container and are never passed as command-line arguments.
# Set each _FILE value to a readable host file. Prefer paths outside this
# repository: docker/secrets/.empty is only the checked-in empty bind fallback,
# and all other docker/secrets files are ignored from Git and Docker builds.
# On Linux, keep the host secret directory root-owned mode 0700 and each file
# root-owned mode 0444. Compose bind-mounts individual files (not the parent),
# so non-root containers can read only the files mounted into them while host
# users cannot traverse the source directory. Do not mount the whole directory.
# ---------------------------------------------------------------------------
POSTGRES_USER=noxa
POSTGRES_PASSWORD=noxa
POSTGRES_PASSWORD_FILE=
POSTGRES_DB=noxa
# Optional full database URL for Compose production deployments. Production
# mode accepts only sslmode=require, verify-ca, or verify-full.
NOXA_COMPOSE_DATABASE_URL=
NOXA_COMPOSE_DATABASE_URL_FILE=
# Used when Compose generates its internal PostgreSQL URL and by the backup
# container's PGSSLMODE. Keep disable only for the local development stack.
POSTGRES_SSLMODE=disable
REDIS_PASSWORD=
REDIS_PASSWORD_FILE=

# When NOXA_COMPOSE_DATABASE_URL or its _FILE form points to an external
# database, the backup profile fails closed until every setting below and one
# BACKUP_POSTGRES_PASSWORD source are set. These deliberately do not inherit
# the application URL, so pg_dump never receives a password-bearing URL.
BACKUP_PGHOST=
BACKUP_PGPORT=
BACKUP_PGUSER=
BACKUP_PGDATABASE=
BACKUP_PGSSLMODE=
BACKUP_POSTGRES_PASSWORD=
BACKUP_POSTGRES_PASSWORD_FILE=
# Optional libpq TLS files for external verify-ca/verify-full deployments.
BACKUP_PGSSLROOTCERT_FILE=
BACKUP_PGSSLCERT_FILE=
BACKUP_PGSSLKEY_FILE=
# rclone remote configuration is mounted only in the backup container.
RCLONE_CONFIG_FILE=
# Keep the scheduled profile resilient. One-shot use is documented below.
BACKUP_RESTART_POLICY=unless-stopped

# coturn ("turn" profile). TURN_SECRET/TURN_REALM configure the coturn
# container; they must equal NOXA_TURN_SECRET/NOXA_TURN_REALM above or
# coturn falls back to its placeholder secret while the server has TURN
# disabled — a silent mismatch (445).
TURN_SECRET=
TURN_SECRET_FILE=
TURN_REALM=noxa
# Public IP clients reach this host on. REQUIRED for anyone outside the host:
# without it coturn advertises relay candidates on its 172.x bridge address
# (445). Leave empty only for host-local testing.
TURN_EXTERNAL_IP=
