{
  "name": "noxa-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.sw.config.js",
    "test:unit": "node --experimental-vm-modules --test unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:preview-privacy": "node --test tests/preview-privacy-browser.mjs",
    "test:directory": "node --test tests/olm-directory-browser.mjs",
    "test:media-worker": "node ../tools/verify-media-worker-build.mjs ../web/app .",
    "test:storage": "node --test tests/ratchet-storage-browser.mjs tests/ratchet-attempt-race-browser.mjs tests/ratchet-retry-validation-browser.mjs tests/ratchet-closure-browser.mjs tests/onboarding-browser.mjs tests/olm-admission-browser.mjs",
    "test:ratchet": "node --test tests/ratchet-interop.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:ui": "playwright test --config playwright.ui.config.js"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "jsqr": "1.4.0",
    "livekit-client": "2.23.0",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.4"
  }
}
