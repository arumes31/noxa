# .dockerignore for noxa
# Keep the Docker build context small and reproducible by excluding files
# that are not needed to compile or run the binary.

# Version control
.git
.gitignore
.gitattributes
.github/

# Separate frontend projects and development-only content
# Server and backup images only use the root Go module and runtime scripts.
client/
website/
docs/
tools/

# Environment / secrets
.env
.env.*
docker/secrets/*
*.pem
*.key
*.crt

# Documentation - keep README for context, ignore the rest
*.md
!README.md

# Editor / IDE config
.vscode/
.idea/
.agents/
.claude/
.codex/
.impeccable/
*.swp
*.swo

# Build artifacts and caches
out/
dist/
bin/
build/
data/
.cache/
.tmp/
temp/
.lintcache*/
graphify-out/
**/node_modules/
**/playwright-report/
**/test-results/
*.exe
*.test
*.out
coverage.out
coverage.txt

# Go module vendoring (we use `go mod download` in the builder)
vendor/

# Docker metadata (avoid recursive context)
Dockerfile
.dockerignore
docker-compose*.yml

# OS junk
.DS_Store
Thumbs.db

# Private deployments and internal work notes
deploy/
tasks/
.kilo/

# Local config that should not be baked into the image
config.yaml
